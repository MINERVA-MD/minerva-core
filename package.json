{
  "name": "minerva",
  "description": "Markdown Editor For Professionals",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "Minerva Core",
    "email": "jsam07@hotmail.com"
  },
  "main": "out/main/index.cjs",
  "scripts": {
    "build": "yarn build:main && yarn build:preload && yarn build:ui",
    "build:main": "cd ./src/core/main && vite build",
    "build:preload": "cd ./src/core/preload && vite build",
    "build:ui": "cd ./src/ui && vite build",
    "package": "cross-env ENVIRONMENT=production yarn build && electron-builder build --config .electron-builder.config.cjs --dir",
    "test": "yarn test:main && yarn test:preload && yarn test:ui && yarn test:e2e",
    "test:e2e": "yarn build && vitest run",
    "test:main": "vitest run -r src/main --passWithNoTests",
    "test:preload": "vitest run -r src/core/preload --passWithNoTests",
    "test:ui": "vitest run -r src/ui --passWithNoTests",
    "dev": "cross-env ENVIRONMENT=development tsx scripts/dev.ts",
    "lint": "eslint . --ext js,mjs,cjs,ts,mts,cts,vue",
    "typecheck:main": "tsc --noEmit -p src/core/main/tsconfig.json",
    "typecheck:preload": "tsc --noEmit -p src/core/preload/tsconfig.json",
    "typecheck:ui": "vue-tsc --noEmit -p src/ui/tsconfig.json",
    "typecheck": "yarn typecheck:main && yarn typecheck:preload && yarn typecheck:ui",
    "postinstall": "cross-env ELECTRON_RUN_AS_NODE=1 electron scripts/postInstall.mjs",
    "format": "npx prettier --write \"**/*.{js,mjs,cjs,ts,mts,cts,vue,json}\"",
    "package:win": "yarn build && electron-builder --config .electron-builder.config.cjs --win",
    "package:mac": "yarn build && electron-builder --config .electron-builder.config.cjs --mac",
    "package:linux": "yarn build && electron-builder --config .electron-builder.config.cjs --linux"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.1",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "18.17.8",
    "@typescript-eslint/eslint-plugin": "6.4.1",
    "cross-env": "7.0.3",
    "electron": "31.1.0",
    "electron-builder": "24.13.3",
    "eslint": "8.47.0",
    "happy-dom": "10.11.0",
    "playwright": "1.45.0",
    "svelte": "^4.2.18",
    "svelte-check": "^3.5.0",
    "tslib": "^2.6.2",
    "tsx": "^4.16.0",
    "typescript": "^5.5.2",
    "unplugin-auto-expose": "0.0.5",
    "vite": "^5.3.2",
    "vitest": "0.34.2"
  },
  "dependencies": {
    "electron-updater": "6.1.1"
  }
}
