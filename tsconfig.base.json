{
    "compilerOptions": {
      "target": "ESNext",
      "module": "ESNext",
      "sourceMap": false,
      "strict": true,
      "esModuleInterop": true,
      "moduleResolution": "node",
      "resolveJsonModule": true,
      "forceConsistentCasingInFileNames": true,
      "skipLibCheck": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "noImplicitAny": false,
      "noImplicitReturns": true,
      "declaration": true,
      "outDir": "./dist",
      "rootDir": "."
    }
  }